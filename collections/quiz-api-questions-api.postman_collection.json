  "item": [
    {
      "id": "cfbae537-02ff-444e-a3dd-f605d42a3732",
      "name": "Questions",
      "description": {
        "content": "Retrieve questions for quizzes or browse across all quizzes",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ef14daf9-545e-484b-afeb-d754e459dcb9",
          "name": "Get questions",
          "request": {
            "name": "Get questions",
            "description": {
              "content": "Two modes: (1) Pass `quiz_id` to get ordered questions for a specific quiz. (2) Omit `quiz_id` to browse questions across all published quizzes with pagination, filtering, and optional randomization. Only approved quizzes and your own quizzes are included.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "questions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "quiz_id",
                  "value": "<string>",
                  "description": "If provided, returns questions for this quiz (Mode 1). If omitted, enters browse mode (Mode 2)."
                },
                {
                  "disabled": false,
                  "key": "include_answers",
                  "value": "<string>",
                  "description": "Set to \"true\" to include answers (Mode 1 only). In browse mode, answers are always included."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Filter by quiz category. Supports comma-separated values for multiple categories (case-insensitive). Browse mode only."
                },
                {
                  "disabled": false,
                  "key": "difficulty",
                  "value": "<string>",
                  "description": "Filter by difficulty. Supports comma-separated values (case-insensitive). Browse mode only."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by question type. Supports comma-separated values. Browse mode only."
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Comma-separated tags to match (browse mode only)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Max questions to return per page in browse mode (1–50)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of questions to skip for pagination (browse mode only)"
                },
                {
                  "disabled": false,
                  "key": "random",
                  "value": "<string>",
                  "description": "Set to \"true\" to shuffle the returned questions randomly (browse mode only)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [

          "name": "List quizzes",
          "request": {
            "name": "List quizzes",
            "description": {
              "content": "Returns a paginated list of published, approved quizzes (plus your own). Supports filtering by category, difficulty, tags, and free-text topic search.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "quizzes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Filter by category (case-insensitive)"
                },
                {
                  "disabled": false,
                  "key": "difficulty",
                  "value": "<string>",
                  "description": "Filter by difficulty level"
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Comma-separated list of tags"
                },
                {
                  "disabled": false,
                  "key": "topic",
                  "value": "<string>",
                  "description": "Free-text search in title, description, and tags"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "popular",
                  "description": "Sort order: popular (plays desc), newest (created desc), or title (alphabetical asc)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Number of results to return (1–50)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
